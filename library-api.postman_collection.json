{
  "info": { "name": "Library Books API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "variable": [ { "key": "baseUrl", "value": "http://localhost:3000" } ],
  "item": [
    { "name": "Root - status (200)", "request": { "method": "GET", "url": "{{baseUrl}}/" } },
    { "name": "GET all books (200)", "request": { "method": "GET", "url": "{{baseUrl}}/api/books" } },
    { "name": "GET one book (200)", "request": { "method": "GET", "url": "{{baseUrl}}/api/books/1" } },
    { "name": "GET nonexistent book (404)", "request": { "method": "GET", "url": "{{baseUrl}}/api/books/999" } },
    { "name": "POST create book (201)", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Clean Code\",\n  \"author\": \"Robert C. Martin\",\n  \"year\": 2008\n}" }, "url": "{{baseUrl}}/api/books" } },
    { "name": "POST invalid body (400)", "request": { "method": "POST", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\n  \"title\": \"\",\n  \"year\": \"abc\"\n}" }, "url": "{{baseUrl}}/api/books" } },
    { "name": "PUT update book (200)", "request": { "method": "PUT", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\n  \"title\": \"Noli Me Tangere (Revised)\",\n  \"author\": \"Jose Rizal\",\n  \"year\": 1887\n}" }, "url": "{{baseUrl}}/api/books/1" } },
    { "name": "PATCH partial update (200)", "request": { "method": "PATCH", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\n  \"year\": 1888\n}" }, "url": "{{baseUrl}}/api/books/2" } },
    { "name": "PUT nonexistent book (404)", "request": { "method": "PUT", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\n  \"title\": \"X\",\n  \"author\": \"Y\",\n  \"year\": 2000\n}" }, "url": "{{baseUrl}}/api/books/999" } },
    { "name": "DELETE book (200)", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/books/2" } },
    { "name": "DELETE nonexistent book (404)", "request": { "method": "DELETE", "url": "{{baseUrl}}/api/books/999" } }
  ]
}
